{
  "name": "djinni-mcp",
  "version": "0.1.0",
  "description": "Local MCP server that lets an AI agent work with a job seeker's djinni.co account",
  "type": "module",
  "bin": {
    "djinni": "dist/cli/index.js",
    "djinni-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
